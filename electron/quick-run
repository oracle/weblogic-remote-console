#!/bin/bash
set -e
JAVA_HOME_TO_USE="${CONSOLE_RUN_JAVA_HOME:-${JAVA_HOME:-}}"
if [ -z "$JAVA_HOME_TO_USE" ]
then
  echo CONSOLE_RUN_JAVA_HOME or JAVA_HOME must be set >&2
  exit 1
fi
if [ ! -x "$JAVA_HOME_TO_USE"/bin/java ]
then
  echo Cannot find java under "$JAVA_HOME_TO_USE" >&2
  exit 1
fi
JAVA_VERSION="$("$JAVA_HOME_TO_USE"/bin/java --version 2>/dev/null || true)"
JAVA_FEATURE_VERSION="$(printf '%s\n' "$JAVA_VERSION" | awk 'NR == 1 { version = $2; gsub(/"/, "", version); sub(/^1[.]/, "", version); sub(/[.].*$/, "", version); print version }')"
if [ "$JAVA_FEATURE_VERSION" != 25 ]
then
  echo Expected JDK 25 for quick-run, but "$JAVA_HOME_TO_USE" reports: >&2
  echo "$JAVA_VERSION" >&2
  echo Set CONSOLE_RUN_JAVA_HOME or JAVA_HOME to a JDK 25 home. >&2
  exit 1
fi
case "$0" in
/*)
  cd "${0%/*}"
  ;;
*/*)
  cd ./"${0%/*}"
esac
if [ ! -f ../runnable/console.jar ]
then
  echo Please do a make before running quick-run >&2
  exit 1
fi
if [ -n "$https_proxy" ]
then
  export ELECTRON_GET_USE_PROXY=true GLOBAL_AGENT_HTTPS_PROXY=$https_proxy
fi
if [ ! -d node_modules ]
then
  npm install
fi
case "$(uname -s)" in
*arwin)
  DISTDIR=node_modules/electron/dist/Electron.app/Contents/MacOS
  ;;
*)
  DISTDIR=node_modules/electron/dist
esac

mkdir -p $DISTDIR

./gen-messages $DISTDIR/resources/nls ../frontend/nls/frontend*.properties

if [ -L $DISTDIR/customjre ]
then
  rm -f $DISTDIR/customjre
fi
if [ -e $DISTDIR/customjre ]
then
  echo $DISTDIR/customjre exists and is not a symbolic link >&2
  if [ -x $DISTDIR/customjre/bin/java ]
  then
    "$DISTDIR"/customjre/bin/java --version >&2 || true
  else
    echo Cannot find java under $DISTDIR/customjre >&2
  fi
elif [ ! -r $DISTDIR/customjre ]
then
  ln -s "$JAVA_HOME_TO_USE" $DISTDIR/customjre
fi

rm -rf $DISTDIR/backend
mkdir -p $DISTDIR/backend
ln -s "${PWD%/*}/runnable"/libs $DISTDIR/backend
cp -f "${PWD%/*}/runnable"/console.jar $DISTDIR/backend

if [ "$1" = internal ]
then
  custom/internal "$DISTDIR"
  rm -f electron-builder-custom.json
fi
cp -f "$PWD"/package.json "$DISTDIR"
npm start -- "$@"
